[Unit]
Description=lighthouse validator client (mainnet)
# /validator is deliberately NOT listed here: on EBS-backed stacks it never
# exists, so this base unit stays mode-agnostic. Instance-store stacks get a
# ConditionPathIsMountPoint=/validator drop-in written by the bootstrap (see
# deploy.go), so the VC refuses to start against an unmounted /validator
# instead of signing off an empty datadir.
RequiresMountsFor=/data
Requires=validator-init.service
After=validator-init.service lighthousebeacon.service

[Service]
User=lighthouse
Group=eth
EnvironmentFile=/etc/swannynode/validator.env
ExecStart=/opt/swannynode/scripts/start_lighthouse_vc.sh
Restart=always
RestartSec=30s
StandardOutput=journal
StandardError=journal
SyslogIdentifier=lighthouse-vc

[Install]
WantedBy=multi-user.target
